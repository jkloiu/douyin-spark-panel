<view class="page page--tab stagger">
  <view class="accbar tap" bindtap="onSwitchAccount">
    <view class="accbar__av">
      <text>{{accInitial}}</text>
      <image wx:if="{{accAvatar}}" class="accbar__avimg" src="{{accAvatar}}" mode="aspectFill" />
    </view>
    <view class="accbar__mid">
      <view class="accbar__name">{{accName || '未选择账号'}}</view>
      <view class="accbar__sub">
        <text wx:if="{{accLive}}">已登录</text>
        <text wx:else>校验中…</text>
        <text> · 共 {{counts.all}} 位好友</text>
      </view>
    </view>
    <view class="accbar__btn">切换</view>
  </view>

  <!-- 手动抓取：面板是异步任务，这里只管提交 + 轮询进度 -->
  <view class="grab card">
    <view class="grab__l">
      <view class="grab__t">
        <text class="grab__dot {{grabbing ? 'grab__dot--on' : (staleCount ? 'grab__dot--warn' : '')}}"></text>
        <text>火花数据</text>
      </view>
      <view class="grab__s">{{grabTip || '每天 06:00 自动抓取'}}</view>
    </view>
    <button
      class="btn btn--sm grab__btn {{grabbing ? '' : 'btn--primary'}}"
      bindtap="grabSpark"
      disabled="{{grabbing}}"
      loading="{{grabbing}}"
    >{{grabbing ? '抓取中 ' + grabSec + 's' : '立即抓取'}}</button>
  </view>

  <!-- 筛选 -->
  <view class="tabs">
    <view class="tabs__i tap-s {{tab === 'all' ? 'tabs__i--on' : ''}}" data-t="all" bindtap="onTab">
      全部 {{counts.all}}
    </view>
    <view class="tabs__i tap-s {{tab === 'risk' ? 'tabs__i--on' : ''}}" data-t="risk" bindtap="onTab">
      需关注 {{counts.risk}}
    </view>
    <view class="tabs__i tap-s {{tab === 'warn' ? 'tabs__i--on' : ''}}" data-t="warn" bindtap="onTab">
      注意 {{counts.warn}}
    </view>
    <view class="tabs__i tap-s {{tab === 'ok' ? 'tabs__i--on' : ''}}" data-t="ok" bindtap="onTab">
      正常 {{counts.ok}}
    </view>
  </view>

  <view wx:if="{{staleCount && !loading}}" class="stalebar">
    ⏰ 有 {{staleCount}} 位好友的火花数据不是今天的（抓取可能没覆盖到）
  </view>

  <view wx:if="{{err}}" class="errbox">{{err}}</view>

  <view wx:if="{{loading}}" class="card">
    <view class="skeleton" style="width: 100%; height: 96rpx; margin-bottom: 20rpx"></view>
    <view class="skeleton" style="width: 100%; height: 96rpx; margin-bottom: 20rpx"></view>
    <view class="skeleton" style="width: 100%; height: 96rpx"></view>
  </view>

  <block wx:else>
    <view wx:if="{{!list.length}}" class="card">
      <view class="empty">这个分类下没有好友</view>
    </view>

    <view wx:for="{{list}}" wx:key="short_id" class="card fcard card--tap" data-sid="{{item.short_id}}" bindtap="goFriend">
      <view class="fcard__top">
        <image
          wx:if="{{item.__avatar}}"
          class="avatar"
          src="{{item.__avatar}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar fcard__ph">{{item.initial}}</view>
        <view class="fcard__mid">
          <view class="fcard__name">{{item.name}}</view>
          <view class="fcard__id mono">{{item.douyin_id}}</view>
        </view>
        <text class="badge {{item.levelCls}}">{{item.levelText}}</text>
      </view>

      <view class="fcard__meta">
        <text wx:if="{{item.todaySent}}" class="badge badge--primary">今日已发</text>
        <text wx:else class="badge">今日未发</text>
        <text wx:if="{{item.lastTime}}" class="child muted small">最近 {{item.lastTime}}</text>
        <text wx:if="{{!item.fresh}}" class="badge badge--warn">数据更新于更早</text>
      </view>

      <view wx:if="{{item.lastContent}}" class="fcard__msg">
        最后一条：{{item.lastContent}}
      </view>
    </view>
  </block>
</view>
