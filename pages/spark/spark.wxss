.accbar {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-1);
}
.accbar__av {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--grad-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  position: relative;
  overflow: hidden;
}
/* 账号真实头像：绝对定位覆盖在首字母占位上（与网页面板切换器同款：字母垫底、图盖上面） */
.accbar__avimg {
  position: absolute;
  left: 0;
  top: 0;
  width: 76rpx;
  height: 76rpx;
}
.accbar__mid {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.accbar__name {
  font-size: 30rpx;
  font-weight: 600;
}
.accbar__sub {
  font-size: 23rpx;
  color: var(--txt3);
  margin-top: 4rpx;
}
.accbar__btn {
  font-size: 25rpx;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
  flex: none;
}

.tabs {
  display: flex;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tabs__i {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  color: var(--txt2);
  padding: 16rpx 0;
  border-radius: 12rpx;
}
.tabs__i--on {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}

.stalebar {
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.errbox {
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 25rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.fcard__top {
  display: flex;
  align-items: center;
}
.fcard__ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-3);
  color: var(--txt2);
  font-size: 30rpx;
  font-weight: 600;
}
.fcard__mid {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
}
.fcard__name {
  font-size: 31rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fcard__id {
  font-size: 23rpx;
  color: var(--txt3);
  margin-top: 4rpx;
}
.fcard__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.child {
  margin-left: auto;
}
.fcard__msg {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line);
  font-size: 24rpx;
  color: var(--txt2);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ── 手动抓取条 ───────────────────────────────────────────── */
.grab {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}
.grab__l {
  flex: 1;
  min-width: 0;
}
.grab__t {
  display: flex;
  align-items: center;
  font-size: 29rpx;
  font-weight: 600;
}
.grab__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--ok);
  margin-right: 12rpx;
  flex: none;
}
.grab__dot--warn {
  background: var(--warn);
}
.grab__dot--on {
  background: var(--primary);
}
.grab__s {
  font-size: 23rpx;
  color: var(--txt3);
  margin-top: 8rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
/* 抓取中会多出「已用秒数」，给按钮一个宽度下限，避免左右跳动 */
.grab__btn {
  flex: none;
  margin-left: 20rpx;
  min-width: 176rpx;
}
