/* 账号条 */
.accbar {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-1);
}
.accbar__av {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--grad-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  position: relative;
  overflow: hidden;
}
/* 账号真实头像：绝对定位覆盖在首字母占位上（与网页面板切换器同款：字母垫底、图盖上面）
   ⚠️ 尺寸必须写显式 rpx：<image> 用百分比宽高在部分机型渲染器里会塌成 0×0
   （全工程正常显示的头像——好友 .avatar 88rpx、me 页 104rpx——都是显式尺寸） */
.accbar__avimg {
  position: absolute;
  left: 0;
  top: 0;
  width: 76rpx;
  height: 76rpx;
}
.accbar__mid {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.accbar__name {
  font-size: 30rpx;
  font-weight: 600;
}
.accbar__sub {
  font-size: 23rpx;
  color: var(--txt3);
  margin-top: 4rpx;
}
.accbar__btn {
  font-size: 25rpx;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
  flex: none;
}

/* 错误条 */
.errbox {
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 25rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

/* 今日状态 */
.today {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
}
/* [20261014b] 已发送是每天的常态 —— 不再用整块绿底，绿色只留一行状态文字。
   原来「大绿底 + 每个好友两个绿徽章」叠在一起，整页绿得刺眼。
   降噪原则：常态用中性色，只有「未续 / 危险」这类要动手的才上彩色。 */
.today--ok {
  background: var(--card-2);
}
.today--ok .today__t {
  color: var(--ok);
}
.today--wait {
  background: var(--card-2);
}
.today__icon {
  font-size: 46rpx;
  margin-right: 20rpx;
  flex: none;
}
.today__t {
  font-size: 29rpx;
  font-weight: 600;
}
.today__s {
  font-size: 24rpx;
  color: var(--txt2);
  margin-top: 6rpx;
}
.today__fail {
  color: var(--danger);
}

/* KPI */
.kpis {
  display: flex;
  margin-bottom: 20rpx;
}
.kpi {
  flex: 1;
  text-align: center;
}
.kpi__n {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}
.kpi__n--risk {
  color: var(--danger);
}
.kpi__l {
  font-size: 23rpx;
  color: var(--txt3);
  margin-top: 4rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 好友行：左右各外扩 12rpx，让按压高亮铺满整行而不缩在卡片内边距里 */
.fitem {
  display: flex;
  align-items: center;
  margin: 0 -12rpx;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid var(--line);
  border-radius: var(--r-sm);
}
.fitem:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.fitem:active {
  border-bottom-color: transparent;
}
.fitem__ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-3);
  color: var(--txt2);
  font-size: 26rpx;
  font-weight: 600;
}
.fitem__mid {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
}
.fitem__name {
  font-size: 29rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fitem__sub {
  margin-top: 4rpx;
}
.fitem__stale {
  color: var(--warn);
}

/* 快捷入口 */
.quick {
  display: flex;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx 0;
  box-shadow: var(--sh-1);
}
.quick__i {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quick__e {
  font-size: 44rpx;
  line-height: 1.2;
  position: relative;
}
.quick__dot {
  position: absolute;
  top: -6rpx;
  right: -22rpx;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 100rpx;
  padding: 0 6rpx;
}
.quick__t {
  font-size: 24rpx;
  color: var(--txt2);
  margin-top: 8rpx;
}
