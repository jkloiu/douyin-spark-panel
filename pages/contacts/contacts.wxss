.accbar {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-1);
}
.accbar__av {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--grad-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  position: relative;
  overflow: hidden;
}
/* 账号真实头像：绝对定位覆盖在首字母占位上（与网页面板切换器同款：字母垫底、图盖上面） */
.accbar__avimg {
  position: absolute;
  left: 0;
  top: 0;
  width: 76rpx;
  height: 76rpx;
}
.accbar__mid {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.accbar__name {
  font-size: 30rpx;
  font-weight: 600;
}
.accbar__sub {
  font-size: 23rpx;
  color: var(--txt3);
  margin-top: 4rpx;
}
.accbar__btn {
  font-size: 25rpx;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
  flex: none;
}

.hintbox {
  background: var(--card-2);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 24rpx;
  color: var(--txt2);
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.strong {
  color: var(--txt);
  font-weight: 600;
}

.errbox {
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 25rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.switchcard {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switchcard__t {
  font-size: 28rpx;
  font-weight: 500;
}
.switchcard__s {
  font-size: 23rpx;
  color: var(--txt3);
  margin-top: 6rpx;
}

.ccard--nm {
  opacity: 0.66;
}
.ccard__top {
  display: flex;
  align-items: center;
}
.ccard__ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-3);
  color: var(--txt2);
  font-size: 30rpx;
  font-weight: 600;
}
.ccard__mid {
  flex: 1;
  margin: 0 18rpx;
  min-width: 0;
}
.ccard__name {
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ccard__name .badge {
  font-size: 20rpx;
  margin-left: 10rpx;
}
.ccard__id {
  font-size: 23rpx;
  color: var(--txt3);
  margin-top: 4rpx;
}
.ccard__pv {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line);
  font-size: 24rpx;
  color: var(--txt2);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 弹窗 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.62);
  z-index: 900;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  animation: up 0.2s ease;
}
@keyframes up {
  from {
    transform: translateY(40rpx);
    opacity: 0.4;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
.sheet__head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.sheet__av {
  width: 112rpx;
  height: 112rpx;
}
.sheet__ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-3);
  color: var(--txt2);
  font-size: 40rpx;
  font-weight: 600;
}
.sheet__mid {
  margin-left: 24rpx;
  min-width: 0;
}
.sheet__name {
  font-size: 34rpx;
  font-weight: 700;
}
.sheet__id {
  font-size: 24rpx;
  color: var(--txt2);
  margin-top: 8rpx;
}
.sheet__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.sheet__row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.sheet__k {
  font-size: 25rpx;
  color: var(--txt3);
  flex: none;
  width: 130rpx;
}
.sheet__v {
  font-size: 26rpx;
  flex: 1;
  line-height: 1.6;
  word-break: break-all;
}
.sheet__warn {
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 23rpx;
  line-height: 1.6;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-top: 20rpx;
}
.sheet__ops {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.sheet__ops .btn {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
  padding: 0 12rpx;
}
