.snaps {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}
.snaps__i {
  font-size: 23rpx;
  color: var(--txt2);
  border: 1rpx solid var(--line);
  border-radius: 100rpx;
  padding: 8rpx 22rpx;
}
.snaps__i--on {
  background: var(--primary-soft);
  color: var(--primary);
  border-color: transparent;
}

/* ── 日期切换（对齐网页面板日报页的操作）───────────────── */
.pick__cur {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--txt);
}
.daynav {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}
.daynav__i {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  color: var(--txt2);
  background: var(--card-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-pill);
  padding: 14rpx 0;
  transition: background var(--t) var(--ease), color var(--t) var(--ease),
    border-color var(--t) var(--ease);
}
.daynav__i--main {
  background: var(--primary-soft);
  border-color: rgba(255, 122, 69, 0.32);
  color: var(--primary);
  font-weight: 600;
}
/* 数据来源：实时生成的时刻 / 存档或归档包的时刻与时段 */
.meta {
  font-size: 22rpx;
  color: var(--txt3);
  line-height: 1.6;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

/* ── 没存档的空状态 ─────────────────────────────────────── */
.emptycard {
  display: flex;
  align-items: flex-start;
}
.emptycard__icon {
  font-size: 44rpx;
  line-height: 1.2;
  margin-right: 20rpx;
  flex: none;
}
.emptycard__mid {
  flex: 1;
  min-width: 0;
}
.emptycard__t {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--txt);
}
.emptycard__s {
  font-size: 23rpx;
  color: var(--txt2);
  line-height: 1.7;
  margin-top: 8rpx;
}
.picks {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}
.picks__l {
  font-size: 22rpx;
  color: var(--txt3);
  margin-bottom: 14rpx;
}
.picks__row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.pickchip {
  font-size: 23rpx;
  color: var(--txt2);
  background: var(--card-2);
  border: 1rpx solid var(--line);
  border-radius: 100rpx;
  padding: 8rpx 22rpx;
}
.pickchip--main {
  background: var(--primary-soft);
  border-color: rgba(255, 122, 69, 0.32);
  color: var(--primary);
  font-weight: 600;
}

.errbox {
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 25rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.drow {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
}
.drow--sub {
  padding-top: 0;
}
.drow__k {
  font-size: 25rpx;
  color: var(--txt3);
  flex: none;
}
.drow__v {
  font-size: 26rpx;
  text-align: right;
  margin-left: 20rpx;
  flex: 1;
}
.drow__v--bad {
  color: var(--danger);
}

.kinds {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 10rpx;
}
.kind {
  font-size: 22rpx;
  background: var(--card-2);
  color: var(--txt2);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.sparkrow {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.flist {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
.frow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.frow__n {
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

.fails {
  margin-top: 16rpx;
  background: var(--danger-soft);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.fails__i {
  font-size: 23rpx;
  color: var(--danger);
  line-height: 1.7;
}
/* [20261008] 「先失败、后成功」用绿色：提醒但不要求处理 */
.fails--ok {
  background: var(--ok-soft);
}
.fails__i--ok {
  color: var(--ok);
}

/* ── [20261013] 操作条：范围切换 + 立即推送（对齐网页面板日报页）── */
.dact {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}
/* 范围切换 = 分段控件，激活态主色软底（与记录页 .seg 同款视觉） */
.seg {
  display: flex;
  background: var(--card-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  padding: 5rpx;
  margin-bottom: 20rpx;
}
.seg__i {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--txt2);
  padding: 13rpx 0;
  border-radius: 16rpx;
}
.seg__i--on {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}
.dact__hint {
  font-size: 21rpx;
  color: var(--txt3);
  line-height: 1.6;
  margin-top: 14rpx;
}
/* 登录态那格可点：用虚线下划线暗示「能按」（手机上没有 hover 可依赖）。
   刻意不改文字颜色 —— 否则会盖掉 .drow__v--bad 的红色告警。 */
.drow__v--tap {
  border-bottom: 1rpx dashed var(--line2);
  padding-bottom: 3rpx;
}
