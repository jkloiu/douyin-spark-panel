/* [20261016] 微信绑定 / 网页登录确认 —— 只用 app.wxss 的 page{} 设计令牌
   （--bg / --bg2 / --card / --card-2 / --txt / --txt2 / --txt3 / --txt4 /
     --line / --primary / --ok / --ok-soft / --warn / --danger / --danger-soft）
   注意：注释里绝不能出现「星号紧跟斜杠」，否则注释会提前结束、编译直接报错。 */

.wxlink__status {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 26rpx;
}
.wxlink__icon {
  font-size: 46rpx;
  line-height: 1;
}
.wxlink__mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.wxlink__t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--txt);
}
.wxlink__s {
  font-size: 24rpx;
  color: var(--txt3);
  line-height: 1.5;
}
.wxlink__s--warn {
  color: var(--warn);
}

.wxlink__seg {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: var(--r-xs);
  background: var(--card-2);
  border: 1rpx solid var(--line);
}
.wxlink__segi {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 27rpx;
  color: var(--txt3);
}
.wxlink__segi.on {
  background: var(--primary);
  color: #ffffff;
  font-weight: 600;
}

.wxlink__card {
  padding: 30rpx 28rpx;
}
.wxlink__hint {
  font-size: 25rpx;
  color: var(--txt3);
  line-height: 1.65;
  margin-bottom: 26rpx;
}
.wxlink__code {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}
.wxlink__input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  padding: 0 26rpx;
  border-radius: 14rpx;
  background: var(--bg2);
  border: 1rpx solid var(--line);
  color: var(--txt);
  font-size: 40rpx;
  letter-spacing: 12rpx;
  text-align: center;
}
.wxlink__mini {
  flex: 0 0 auto;
  padding: 0 22rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 14rpx;
  background: var(--card-2);
  border: 1rpx solid var(--line);
  color: var(--txt2);
  font-size: 25rpx;
}
.wxlink__err {
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 25rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  margin-bottom: 22rpx;
  line-height: 1.5;
}
.wxlink__ok {
  background: var(--ok-soft);
  color: var(--ok);
  font-size: 25rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  margin-bottom: 22rpx;
  line-height: 1.5;
}

.wxlink__menui {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 26rpx 26rpx;
  font-size: 27rpx;
  color: var(--txt);
}
.wxlink__menuit {
  flex: 1;
}
.wxlink__a {
  color: var(--txt3);
}

.wxlink__foot {
  margin: 30rpx 8rpx 20rpx;
  font-size: 23rpx;
  color: var(--txt4);
  text-align: center;
  line-height: 1.6;
}

.ph {
  color: var(--txt3);
  letter-spacing: 0;
  font-size: 28rpx;
}
