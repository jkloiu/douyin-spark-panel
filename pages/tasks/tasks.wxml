<view class="page page--tab stagger">
  <view class="accbar tap" bindtap="onSwitchAccount">
    <view class="accbar__av">
      <text>{{accInitial}}</text>
      <image wx:if="{{accAvatar}}" class="accbar__avimg" src="{{accAvatar}}" mode="aspectFill" />
    </view>
    <view class="accbar__mid">
      <view class="accbar__name">{{accName || '未选择账号'}}</view>
      <view class="accbar__sub">
        <text wx:if="{{accLive}}">已登录</text>
        <text wx:else>校验中…</text>
        <text> · {{tasks.length}} 个定时任务</text>
      </view>
    </view>
    <view class="accbar__btn">切换</view>
  </view>

  <view wx:if="{{runState}}" class="runbar">
    <text class="runbar__spin">⏳</text>
    <view class="runbar__mid">
      <view class="runbar__t">任务执行中</view>
      <view class="runbar__s">{{runState.desc || runState.target || '正在发送…'}}</view>
    </view>
  </view>

  <view wx:if="{{err}}" class="errbox">{{err}}</view>

  <view wx:if="{{loading}}" class="card">
    <view class="skeleton" style="width: 100%; height: 200rpx; margin-bottom: 24rpx"></view>
    <view class="skeleton" style="width: 100%; height: 200rpx"></view>
  </view>

  <block wx:else>
    <view wx:if="{{!tasks.length}}" class="card">
      <view class="empty">还没有定时任务</view>
    </view>

    <view wx:for="{{tasks}}" wx:key="id" class="card task">
      <view class="task__head">
        <view class="task__title">
          <text class="tag {{item.type === 'custom' ? 'tag--custom' : 'tag--main'}}">{{item.typeText}}</text>
          <text class="task__name">{{item.type === 'custom' ? (item.targetName || '未命名目标') : item.description}}</text>
        </view>
        <text class="badge {{item.enabled ? 'badge--ok' : ''}}">{{item.enabled ? '启用中' : '已停用'}}</text>
      </view>

      <view class="task__rows">
        <view class="task__row">
          <text class="task__k">执行时间</text>
          <text class="task__v">每天 {{item.timeText}}<text wx:if="{{item.delay}}">（随机延迟 {{item.delay}} 分钟）</text></text>
        </view>
        <view class="task__row" wx:if="{{item.enabled && item.nextRun}}">
          <text class="task__k">下次执行</text>
          <text class="task__v">{{item.nextRun}}</text>
        </view>
        <view class="task__row">
          <text class="task__k">上次执行</text>
          <text class="task__v {{item.lastOk === false ? 'task__v--fail' : ''}}">{{item.lastText}}</text>
        </view>
        <view class="task__row" wx:if="{{item.type === 'custom'}}">
          <text class="task__k">消息模式</text>
          <text class="task__v">{{item.msgMode === 'custom' ? '自定义文案' : '火花模板'}}</text>
        </view>
      </view>

      <view class="task__ops">
        <button
          class="btn btn--sm btn--primary"
          data-id="{{item.id}}"
          bindtap="runNow"
          disabled="{{busyId === item.id}}"
        >
          立即运行
        </button>
        <button
          class="btn btn--sm"
          data-id="{{item.id}}"
          data-on="{{item.enabled}}"
          bindtap="toggle"
          disabled="{{busyId === item.id}}"
        >
          {{item.enabled ? '停用' : '启用'}}
        </button>
        <button
          wx:if="{{item.canEdit}}"
          class="btn btn--sm"
          data-id="{{item.id}}"
          bindtap="editTask"
          disabled="{{busyId === item.id}}"
        >
          编辑
        </button>
        <button
          wx:if="{{item.canEdit}}"
          class="btn btn--sm btn--danger"
          data-id="{{item.id}}"
          bindtap="remove"
          disabled="{{busyId === item.id}}"
        >
          删除
        </button>
      </view>
    </view>

    <button class="btn btn--primary btn--block addbtn" bindtap="addTask">+ 新建定时任务</button>
  </block>
</view>
