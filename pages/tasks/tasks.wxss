.accbar {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-1);
}
.accbar__av {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--grad-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  position: relative;
  overflow: hidden;
}
/* 账号真实头像：绝对定位覆盖在首字母占位上（与网页面板切换器同款：字母垫底、图盖上面） */
.accbar__avimg {
  position: absolute;
  left: 0;
  top: 0;
  width: 76rpx;
  height: 76rpx;
}
.accbar__mid {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.accbar__name {
  font-size: 30rpx;
  font-weight: 600;
}
.accbar__sub {
  font-size: 23rpx;
  color: var(--txt3);
  margin-top: 4rpx;
}
.accbar__btn {
  font-size: 25rpx;
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
  flex: none;
}

.runbar {
  display: flex;
  align-items: center;
  background: var(--warn-soft);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.runbar__spin {
  font-size: 38rpx;
  margin-right: 18rpx;
}
.runbar__t {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--warn);
}
.runbar__s {
  font-size: 23rpx;
  color: var(--txt2);
  margin-top: 2rpx;
}

.errbox {
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 25rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.task__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.task__title {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}
.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex: none;
  margin-right: 14rpx;
}
.tag--custom {
  background: var(--primary-soft);
  color: var(--primary);
}
.tag--main {
  background: var(--accent-soft);
  color: var(--accent);
}
.task__name {
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task__rows {
  background: var(--card-2);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
}
.task__row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
}
.task__k {
  font-size: 24rpx;
  color: var(--txt3);
  flex: none;
}
.task__v {
  font-size: 25rpx;
  text-align: right;
  margin-left: 20rpx;
  word-break: break-all;
}
.task__v--fail {
  color: var(--danger);
}

/* 一行两个：gap 16rpx，每列宽 = 50% - 8rpx（app.wxss 已对 button 设 border-box）。
   4 个按钮排成 2×2；只有「立即运行 + 停用/启用」两个时独占一行两个。 */
.task__ops {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}
.task__ops .btn {
  flex: none;
  width: calc(50% - 8rpx);
}

.addbtn {
  margin-top: 8rpx;
}
