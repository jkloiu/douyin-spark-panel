.ucard {
  display: flex;
  align-items: center;
  background: var(--grad-primary);
  border-radius: var(--radius);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: var(--sh-primary);
}
/* ── 头像位（[20261014] 微信头像授权）────────────────────────────
   三层叠在一起：图片 / 首字母兜底 / 透明 button。
   button 必须盖在最上面 —— open-type="chooseAvatar" 只有 button 组件认，
   所以做法是「按钮铺满头像、做成全透明」，用户感知就是点了自己的头像。 */
.ucard__avwrap {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  flex: none;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.24);
}
.ucard__av {
  width: 104rpx;
  height: 104rpx;
  font-size: 46rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ucard__avimg {
  width: 104rpx;
  height: 104rpx;
  display: block;
}
/* 压缩/上传中的遮罩 */
.ucard__avbusy {
  position: absolute;
  left: 0;
  top: 0;
  width: 104rpx;
  height: 104rpx;
  background: rgba(0, 0, 0, 0.42);
}
/* 全透明按钮（不能用 opacity:0 —— 个别机型上会影响点击命中） */
.ucard__avbtn {
  position: absolute;
  left: 0;
  top: 0;
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  font-size: 0;
}
.ucard__avbtn::after {
  border: none;
}
.ucard__hint {
  font-size: 21rpx;
  opacity: 0.82;
  margin-top: 6rpx;
}
.ucard__mid {
  margin-left: 24rpx;
  min-width: 0;
}
.ucard__name {
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}
.ucaard__role {
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 100rpx;
  padding: 3rpx 14rpx;
  margin-left: 14rpx;
  font-weight: 400;
}
.ucard__sub {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 8rpx;
}

.menu {
  padding: 0 28rpx;
}
/* 左右外扩 16rpx：按压高亮铺满整行，图标不脱出视觉对齐线 */
.menu__i {
  display: flex;
  align-items: center;
  margin: 0 -16rpx;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid var(--line);
  border-radius: var(--r-sm);
}
.menu__i:last-child {
  border-bottom: none;
}
.menu__i:active {
  border-bottom-color: transparent;
}
.menu__e {
  font-size: 36rpx;
  width: 56rpx;
  flex: none;
}
.menu__t {
  flex: 1;
  font-size: 29rpx;
}
.menu__mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.menu__mid .menu__t {
  flex: none;
}
.menu__sub {
  font-size: 22rpx;
  color: var(--txt3);
  margin-top: 4rpx;
}
.menu__badge {
  background: var(--primary);
  color: #fff;
  font-size: 21rpx;
  line-height: 1.5;
  border-radius: 100rpx;
  padding: 2rpx 14rpx;
  margin-right: 12rpx;
  flex: none;
}
.menu__a {
  font-size: 25rpx;
  color: var(--txt3);
}

.footnote {
  text-align: center;
  font-size: 22rpx;
  color: var(--txt3);
  margin-top: 32rpx;
  line-height: 1.6;
}
