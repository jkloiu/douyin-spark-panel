.qrbox {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}
.qr {
  width: 440rpx;
  height: 440rpx;
  border-radius: 16rpx;
  background: var(--card-2);
}
.qr--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--line);
}
.qr__wait {
  color: var(--txt3);
  font-size: 26rpx;
}
.qr__err {
  color: var(--danger);
  font-size: 24rpx;
  text-align: center;
  padding: 0 40rpx;
  line-height: 1.6;
}

.statusbar {
  text-align: center;
  margin-bottom: 28rpx;
}

.steps {
  background: var(--card-2);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 28rpx;
}
.step {
  font-size: 24rpx;
  color: var(--txt2);
  line-height: 2;
}

.errbox {
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.verify {
  background: var(--warn-soft);
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}
.verify__hint {
  font-size: 24rpx;
  color: var(--txt2);
  line-height: 1.6;
  margin-bottom: 18rpx;
}
.verify__inp {
  width: 100%;
  box-sizing: border-box;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  margin-bottom: 18rpx;
}

.tipcard {
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 23rpx;
  line-height: 1.6;
  border-radius: 14rpx;
  padding: 22rpx 26rpx;
}
